# Telegram bot token (preferred over UI-stored token)
TELEGRAM_BOT_TOKEN=

# Optional secret for webhook validation (x-telegram-bot-api-secret-token)
TELEGRAM_WEBHOOK_SECRET=

# Collector poll interval (ms)
COLLECTOR_POLL_MS=3000

# LLM 2차 보조 (패턴 실패·QC 의심 톡만). 키 없으면 로컬 휴리스틱 보조.
OPENAI_API_KEY=
# 또는 호환 API:
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_FORCE_MOCK=1
